{{~
    domain_fields = []
    for item in fields
        if item.binds_domain_value
            domain_fields = domain_fields | array.add item
        end
    end
~}}
{{ if domain_fields.size > 0 }}{{ for item in domain_fields }}{{ if item.composite }}{{ include "BindCompoundValues.sbn" }}{{ else if item.optional }}        var {{ item.local_name }}Result = command.{{ item.name }} is { } {{ item.local_name }}Input
            ? {{ item.value_object }}.Create({{ item.local_name }}Input)
            : null;
{{ else }}        var {{ item.local_name }}Result = {{ item.value_object }}.Create(command.{{ item.name }});
{{ end }}{{ end }}
        var validation = Result.Combine(
{{ for item in domain_fields }}            {{ item.local_name }}Result{{ if item.optional }} ?? Result.Success(){{ end }}{{ if !for.last }},
{{ end }}{{ end }});

        if (validation.IsFailure)
        {
            return {{ fail_start }}errors: validation.Errors{{ fail_end }};
        }

{{ end -}}
