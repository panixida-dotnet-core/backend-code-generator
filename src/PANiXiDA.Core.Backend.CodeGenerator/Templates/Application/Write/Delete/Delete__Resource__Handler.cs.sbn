using {{ model.domain }};
{{ if model.child && model.child.parent_domain != model.domain }}using {{ model.child.parent_domain }};
{{ end }}using {{ if model.child }}{{ model.child.parent_domain }}{{ else }}{{ model.domain }}{{ end }}.Abstractions;

namespace {{ model.module }}.Application.{{ model.feature }}.Write.Delete;

public sealed class Delete{{ model.resource }}Handler(I{{ model.aggregate_feature }}Repository {{ model.write_repository_parameter }})
    : ICommandHandler<Delete{{ model.resource }}Command, Result>{{ if model.child }}, IRequireTransaction{{ end }}
{
    public async Task<Result> HandleAsync(
        Delete{{ model.resource }}Command command,
        CancellationToken cancellationToken)
    {
{{ if model.child }}{{ failure = "Result.Failure"
   with_id = true
   parent_id_type = model.child.parent_id
   id_type = model.id
   include "LoadParent.sbn" }}        return {{ model.aggregate_variable }}.{{ model.child.delete_method }}(idResult.Value);
{{ else }}        var idResult = {{ model.id }}.Create(command.Id);

        if (idResult.IsFailure)
        {
            return Result.Failure(idResult.Errors);
        }

        var {{ model.aggregate_variable }} = await {{ model.write_repository_parameter }}.GetByIdAsync(
            idResult.Value,
            cancellationToken);

        if ({{ model.aggregate_variable }} is null)
        {
            return Result.Failure(
                Error.NotFound($"{{ model.resource }} with id '{command.Id}' was not found."));
        }

        {{ model.write_repository_parameter }}.Delete({{ model.aggregate_variable }});

        return Result.Success();
{{ end }}    }
}
