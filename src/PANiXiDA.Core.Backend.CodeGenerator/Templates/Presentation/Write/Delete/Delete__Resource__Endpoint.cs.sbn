using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;

namespace {{ model.module }}.Presentation.Features.{{ model.feature }}.Write.Delete;

internal sealed class Delete{{ model.resource }}Endpoint : IEndpoint<{{ model.feature }}Endpoints>
{
    public string Route { get; } = "/" + {{ model.feature }}Endpoints.IdRoute;
    public string Name { get; } = "Delete{{ model.resource }}";
    public string Summary { get; } = "Delete {{ model.resource }}";

    public void Map(EndpointMapBuilder builder)
    {
        builder.MapDelete(builder.Route, HandleAsync)
            .Produces(StatusCodes.Status204NoContent)
            .ProducesValidationProblem(StatusCodes.Status400BadRequest)
            .ProducesProblem(StatusCodes.Status404NotFound);
    }

    private static async Task<IResult> HandleAsync(
{{ if model.child }}        Guid {{ model.child.route_id }},
{{ end }}        Guid id,
        IMediator mediator,
        CancellationToken cancellationToken)
    {
        var result = await mediator.SendAsync(
            Delete{{ model.resource }}Mapper.ToCommand({{ if model.child }}parentId: {{ model.child.route_id }}, {{ end }}id: id),
            cancellationToken);

        return result.ToHttpResult(onSuccess: TypedResults.NoContent);
    }
}
