    private static IQueryable<{{ model.resource }}ReadDbModel> ApplyFilter(
        IQueryable<{{ model.resource }}ReadDbModel> query,
        {{ model.feature }}Filter filter)
    {
        if (string.IsNullOrWhiteSpace(filter.Search))
        {
            return query;
        }

        var search = filter.Search.Trim()
            .Replace("\\", "\\\\", StringComparison.Ordinal)
            .Replace("%", "\\%", StringComparison.Ordinal)
            .Replace("_", "\\_", StringComparison.Ordinal);
        var pattern = $"%{search}%";

        return query.Where(item =>
{{ for field in model.search_fields }}            EF.Functions.ILike(item.{{ field.name }}{{ if field.optional }} ?? string.Empty{{ end }}, pattern, "\\"){{ if !for.last }} ||
{{ end }}{{ end }});
